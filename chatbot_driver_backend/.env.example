# --- App ---
APP_NAME=GoRush Driver AI Chatbot Backend
APP_TITLE=GoRush Driver AI Chatbot Backend
ENV=development
DEBUG=true
PORT=8001

# --- Security ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://gorush:gorush@localhost:5432/gorush

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Gateway ---
# mock = no external calls, deterministic canned responses (default, safe to start with)
# anthropic = real Claude calls (requires LLM_API_KEY)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
